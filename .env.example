# ==========================================
# Variables de Entorno - Museo Virtual
# Copia este archivo como .env y ajusta los valores
# ==========================================

# Puerto del servidor (default: 3000)
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Origenes permitidos para CORS (separados por comas)
# En produccion, pon tu dominio: https://tumuseo.com
CORS_ORIGIN=*

# Limite de tamano para uploads (en MB)
MAX_IMAGE_SIZE=10
MAX_AUDIO_SIZE=50
